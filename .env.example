# App configurations
APP_NAME=Wingman
DEBUG=True
LOG_LEVEL=INFO

# OpenAI API Keys (To be filled via Onboarding)
OPENAI_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
REASONING_EFFORT=low

# Document Processing (OpenAI)
USE_VISION_OCR=True
OCR_MODEL=gpt-4o-mini

# Internal Docker Networking URIs (on docker)
MONGODB_URL=mongodb://root:example@mongodb:27017/
MONGODB_DB_NAME=wingman
REDIS_URL=redis://redis:6379/0

# Neo4j Setup (on docker)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j


# ChromaDB Setup (on docker)
CHROMA_SERVER_URL=http://chromadb:8000
CHROMA_COLLECTION_NAME=wingman_memory
CHROMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

